# NEXUS AI CRYPTO DECISION ENGINE — ENVIRONMENT SETUP GUIDE
# Copy this file to .env.local to configure your local credentials:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 🔑 CORE REQUIRED CREDENTIALS
# ------------------------------------------------------------------------------

# 1. Clerk Authentication (Required for user authentication and sign-in)
# Obtain these from your Clerk dashboard: https://dashboard.clerk.com/
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# 2. Supabase Storage & Database (Required for AI Memory and Profile Sync)
# Obtain these from your Supabase Project Settings API dashboard: https://supabase.com/
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. AI Providers (Required for algorithmic trade analysis and strategy rationales)
# OpenAI API Key (Standard GPT models): https://platform.openai.com/
VITE_OPENAI_API_KEY=your_openai_api_key_here
# Groq API Key (Fast Llama/Hermes models): https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_api_key_here

# 4. Dune Analytics (Required for macro gas, volume and institutional flows)
# Obtain from Dune Developer dashboard: https://dune.com/settings/api
DUNE_API_KEY=your_dune_api_key_here

# ------------------------------------------------------------------------------
# 📡 OPTIONAL API INTEGRATIONS (FALLBACK INTEGRATIONS & MARKET METRICS)
# ------------------------------------------------------------------------------
# VITE_COINGECKO_API_KEY=your_coingecko_api_key
# VITE_CMC_API_KEY=your_coinmarketcap_api_key
# VITE_ETHERSCAN_API_KEY=your_etherscan_api_key
# VITE_TAAPI_KEY=your_taapi_api_key
# VITE_LUNARCRUSH_KEY=your_lunarcrush_api_key
